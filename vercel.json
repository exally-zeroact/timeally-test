{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node tests/mirror-match.test.mjs --vercel",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(js|lib|css)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
